#include <iostream>
using namespace std;

class MyClass 
{
	public:
		void fun(int arr[], int n) 
		{
		int min=arr[0];
	    int pos=0;
	    for(int i=1;i<n;i++)
	{
		if(arr[i]<min)
		{
			min=arr[i];
			pos=i;
		}
	}
	int temp=arr[pos];
	arr[pos]=arr[n-1];
	arr[n-1]=temp;
}
};
int main()
{
	int n;
	cin>>n;
	int arr[100];
	for(int i=0;i<n;i++)
	{
		cin>>arr[i];
	}
	for(int i=0;i<n;i++)
	{
	cout<<arr[i]<<",";
}
cout<<endl;
	MyClass obj;
	obj.fun(arr,n);
	for(int i=0;i<n;i++) 
	{
	cout<<arr[i]<<",";
	}
	system("pause");
}
